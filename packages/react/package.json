{
  "name": "@page-assistant/react",
  "version": "0.9.0",
  "description": "Agent mode dock for React 19 / Next.js: chat panel, confirm cards, guided walkthroughs with a pointer, anchor highlights, voice. Talks to @page-assistant/server's agent route.",
  "license": "MIT",
  "engines": { "node": ">=20.6.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/philipposk/page-assistant.git", "directory": "packages/react" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@page-assistant/widget": "0.9.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  }
}
