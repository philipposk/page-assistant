# Backend keys (server only — never shipped to the browser).
# At least one LLM key is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
PA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
PA_OPENAI_MODEL=gpt-4o-mini
PA_OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Voice (optional). ElevenLabs gives the best voice; OpenAI TTS/Whisper is the fallback.
ELEVENLABS_API_KEY=
PA_ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Server
PORT=8787
PA_CORS_ORIGIN=*

# Auth: when set, spend endpoints require `Authorization: Bearer <token>`. Unset = open (dev).
PA_AUTH_TOKEN=

# --- Proxy / IP handling ---
# OFF by default. Per-IP rate limiting uses req.ip; behind nginx/Cloudflare that would be
# the PROXY's IP (so all users share one bucket) unless you enable this. But enabling it
# when you are NOT behind a trusted proxy lets a client spoof X-Forwarded-For and dodge
# rate limits. Set to 1/true ONLY when a trusted proxy sits in front; a number = trusted hops.
PA_TRUST_PROXY=

# --- Rate limits (requests per 60s per IP). Bad/negative values fall back to these defaults. ---
PA_RATE_LLM=30
PA_RATE_VOICE=20
PA_RATE_AGENT=10
PA_RATE_FEEDBACK=10
PA_RATE_ANALYTICS=60

# --- Outbound provider timeouts (ms) + output caps ---
PA_LLM_TIMEOUT_MS=30000
PA_VOICE_TIMEOUT_MS=30000
PA_MAX_TOKENS=1024
# Max chat-history messages sent to the model per turn (system + last N).
PA_HISTORY_WINDOW=20

# --- Body limits ---
PA_JSON_LIMIT=256kb
PA_RAW_LIMIT=6mb
PA_STT_MAX_BYTES=5242880

# --- Agent endpoint memory isolation ---
# Max distinct caller sessions to keep in-memory facts for (oldest evicted past this).
PA_MAX_SESSIONS=1000

# --- Daily budget (resets at UTC midnight). Set ONE of these to cap spend; when the cap is
# hit the LLM/agent routes return a friendly 429 instead of silently draining credit. ---
# PA_DAILY_BUDGET caps total TOKENS per day; PA_DAILY_REQUEST_BUDGET caps REQUESTS per day.
PA_DAILY_BUDGET=
PA_DAILY_REQUEST_BUDGET=

# Where the file-backed ticket store writes (bin.ts default).
PA_TICKETS_FILE=./data/tickets.json

# Pin the LLM model server-side. When set, the router ignores whatever model the client
# asks for, and the widget hides its model picker instead of showing a dead control.
# PA_FIXED_MODEL=claude-sonnet-5
